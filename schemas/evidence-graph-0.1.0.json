{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/niwantha33/zephyr-eclipse-workbench/blob/main/schemas/evidence-graph-0.1.0.json",
  "title": "Zephyr Evidence Graph v0.1.0 (observational prototype)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "nodes",
    "edges",
    "missing_evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "observations-only"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "confidence",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_:@./+-]+$"
          },
          "type": {
            "enum": [
              "project",
              "image",
              "artifact",
              "kconfig_observation"
            ]
          },
          "confidence": {
            "enum": [
              "confirmed",
              "derived",
              "possible",
              "unknown"
            ]
          },
          "data": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "required": [
              "artifact",
              "sha256",
              "producing_tool",
              "tool_version",
              "extraction"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "producing_tool": {
                "const": "unknown"
              },
              "tool_version": {
                "const": "unknown"
              },
              "extraction": {
                "const": "read-only SHA-256 file observation"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100000
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "contains",
              "observed-in"
            ]
          }
        }
      },
      "maxItems": 200000
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image",
          "artifact",
          "state"
        ]
      },
      "maxItems": 10000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100
    }
  }
}
