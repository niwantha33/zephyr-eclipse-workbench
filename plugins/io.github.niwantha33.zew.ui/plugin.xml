<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<plugin>
  <extension point="org.eclipse.core.resources.markers" id="buildProblem" name="Zephyr build diagnostic">
    <super type="org.eclipse.core.resources.problemmarker"/><persistent value="true"/>
  </extension>
  <extension point="org.eclipse.ui.newWizards">
    <category id="io.github.niwantha33.zew.category" name="Zephyr"/>
    <wizard id="io.github.niwantha33.zew.newProject" name="Zephyr Project" category="io.github.niwantha33.zew.category" project="true" class="io.github.niwantha33.zew.ui.ZephyrProjectWizard"/>
  </extension>
  <extension point="org.eclipse.ui.importWizards">
    <category id="io.github.niwantha33.zew.importCategory" name="Zephyr"/>
    <wizard id="io.github.niwantha33.zew.importProject" name="Existing Zephyr Application" category="io.github.niwantha33.zew.importCategory" class="io.github.niwantha33.zew.ui.ZephyrImportWizard"/>
  </extension>
  <extension point="org.eclipse.cdt.core.LanguageSettingsProvider">
    <provider id="io.github.niwantha33.zew.ui.editor.compiler" name="Zephyr compiler settings" class="io.github.niwantha33.zew.ui.ZephyrLanguageSettingsProvider"/>
  </extension>
  <extension point="org.eclipse.cdt.core.CConfigurationDataProvider" id="editorData">
    <provider class="io.github.niwantha33.zew.ui.ZephyrEditorDataProvider"/>
  </extension>
  <extension point="org.eclipse.ui.propertyPages">
    <page id="io.github.niwantha33.zew.projectProperties" name="Zephyr"
          objectClass="org.eclipse.core.resources.IProject"
          class="io.github.niwantha33.zew.ui.ZephyrProjectPropertyPage"/>
  </extension>
  <extension point="org.eclipse.debug.core.launchConfigurationTypes">
    <launchConfigurationType id="io.github.niwantha33.zew.ui.launchType"
        name="Zephyr Application" modes="run,debug"
        public="true"/>
  </extension>
  <extension point="org.eclipse.debug.core.launchDelegates">
    <launchDelegate id="io.github.niwantha33.zew.ui.runRunner"
        type="io.github.niwantha33.zew.ui.launchType" modes="run"
        delegate="io.github.niwantha33.zew.ui.ZephyrLaunchDelegate"
        name="Zephyr Runner"/>
  </extension>
  <extension point="org.eclipse.debug.core.launchDelegates">
    <launchDelegate id="io.github.niwantha33.zew.ui.nativeDsfDebug"
        type="io.github.niwantha33.zew.ui.launchType" modes="debug"
        delegate="io.github.niwantha33.zew.ui.ZephyrNativeDebugDelegate"
        name="Zephyr (CDT DSF-GDB)"
        sourceLocatorId="org.eclipse.cdt.debug.core.sourceLocator"
        sourcePathComputerId="org.eclipse.cdt.debug.core.sourcePathComputer"/>
  </extension>
  <extension point="org.eclipse.debug.ui.launchConfigurationTabGroups">
    <launchConfigurationTabGroup id="io.github.niwantha33.zew.ui.launchTabs"
        type="io.github.niwantha33.zew.ui.launchType"
        class="io.github.niwantha33.zew.ui.ZephyrLaunchTabs"/>
  </extension>
  <extension point="org.eclipse.ui.startup"><startup class="io.github.niwantha33.zew.ui.SetupStartup"/></extension>
  <extension point="org.eclipse.core.resources.builders" id="zephyrBuilder" name="Zephyr Project Builder">
    <builder hasNature="false"><run class="io.github.niwantha33.zew.ui.ZephyrProjectBuilder"/></builder>
  </extension>
  <extension point="org.eclipse.ui.startup"><startup class="io.github.niwantha33.zew.ui.UpdateStartup"/></extension>
  <extension point="org.eclipse.ui.preferencePages">
    <page id="io.github.niwantha33.zew.preferences" name="Zephyr Workbench" class="io.github.niwantha33.zew.ui.WorkbenchPreferences"/>
  </extension>
  <extension point="org.eclipse.ui.commands">
    <command id="io.github.niwantha33.zew.debugserver" name="Start Debug Server" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.debug" name="Debug Application" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.flash" name="Flash Application" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.run" name="Run in Emulator" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.editor" name="Refresh C/C++ Editor Settings" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.setup" name="Set Up Zephyr" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.tools" name="Install / Manage Zephyr Tools" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.about" name="About Zephyr Workbench" categoryId="io.github.niwantha33.zew.commands"/>
    <category id="io.github.niwantha33.zew.commands" name="Zephyr Workbench"/>
    <command id="io.github.niwantha33.zew.checkUpdates" name="Check for Workbench Updates" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.updateConnection" name="Configure Workbench Updates" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.diagnostics" name="Check Environment" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.build" name="Build Application" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.rebuild" name="Pristine Rebuild" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.cancel" name="Cancel Operation" categoryId="io.github.niwantha33.zew.commands"/>
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler commandId="io.github.niwantha33.zew.debugserver" class="io.github.niwantha33.zew.ui.ProjectActionHandler"/>
    <handler commandId="io.github.niwantha33.zew.debug" class="io.github.niwantha33.zew.ui.ZephyrDebugHandler"/>
    <handler commandId="io.github.niwantha33.zew.flash" class="io.github.niwantha33.zew.ui.ProjectActionHandler"/>
    <handler commandId="io.github.niwantha33.zew.run" class="io.github.niwantha33.zew.ui.ProjectActionHandler"/>
    <handler commandId="io.github.niwantha33.zew.editor" class="io.github.niwantha33.zew.ui.EditorHandler"/>
    <handler commandId="io.github.niwantha33.zew.setup" class="io.github.niwantha33.zew.ui.SetupHandler"/>
    <handler commandId="io.github.niwantha33.zew.tools" class="io.github.niwantha33.zew.ui.ToolsHandler"/>
    <handler commandId="io.github.niwantha33.zew.about" class="io.github.niwantha33.zew.ui.VersionHandler"/>
    <handler commandId="io.github.niwantha33.zew.checkUpdates" class="io.github.niwantha33.zew.ui.UpdateHandler"/>
    <handler commandId="io.github.niwantha33.zew.updateConnection" class="io.github.niwantha33.zew.ui.UpdateHandler"/>
    <handler commandId="io.github.niwantha33.zew.diagnostics" class="io.github.niwantha33.zew.ui.WorkbenchHandler"/>
    <handler commandId="io.github.niwantha33.zew.build" class="io.github.niwantha33.zew.ui.WorkbenchHandler"/>
    <handler commandId="io.github.niwantha33.zew.rebuild" class="io.github.niwantha33.zew.ui.WorkbenchHandler"/>
    <handler commandId="io.github.niwantha33.zew.cancel" class="io.github.niwantha33.zew.ui.WorkbenchHandler"/>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
      <menu id="io.github.niwantha33.zew.menu" label="Zephyr">
        <command commandId="io.github.niwantha33.zew.setup" label="Set Up Zephyr..." style="push"/>
        <command commandId="io.github.niwantha33.zew.tools" label="Install / Manage Zephyr Tools..." style="push"/>
        <separator name="tools" visible="true"/>
        <command commandId="io.github.niwantha33.zew.diagnostics" label="Check Environment" style="push"/>
        <separator name="build" visible="true"/>
        <command commandId="io.github.niwantha33.zew.editor" label="Refresh C/C++ Editor Settings" style="push"/>
        <command commandId="io.github.niwantha33.zew.build" label="Build Application" style="push"/>
        <command commandId="io.github.niwantha33.zew.rebuild" label="Pristine Rebuild" style="push"/>
        <command commandId="io.github.niwantha33.zew.cancel" label="Cancel Operation" style="push"/>
        <command commandId="io.github.niwantha33.zew.run" label="Run in Emulator..." style="push"/>
        <command commandId="io.github.niwantha33.zew.flash" label="Flash Application..." style="push"/>
        <command commandId="io.github.niwantha33.zew.debug" label="Debug Application..." style="push"/>
        <command commandId="io.github.niwantha33.zew.debugserver" label="Start Debug Server..." style="push"/>
        <separator name="updates" visible="true"/>
        <command commandId="io.github.niwantha33.zew.checkUpdates" label="Check for Workbench Updates..." style="push"/>
        <command commandId="io.github.niwantha33.zew.updateConnection" label="Configure Workbench Updates..." style="push"/>
        <separator name="about" visible="true"/>
        <command commandId="io.github.niwantha33.zew.about" label="About Zephyr Workbench..." style="push"/>
      </menu>
    </menuContribution>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
      <toolbar id="io.github.niwantha33.zew.ui.targetActions">
        <command commandId="io.github.niwantha33.zew.flash" label="Flash Zephyr firmware" style="push" tooltip="Flash selected Zephyr project"/>
        <command commandId="io.github.niwantha33.zew.debug" label="Debug Zephyr application" style="push" tooltip="Debug selected Zephyr project using CDT GDB"/>
      </toolbar>
    </menuContribution>
  </extension>
</plugin>

