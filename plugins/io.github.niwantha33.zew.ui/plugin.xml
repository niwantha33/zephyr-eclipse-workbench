        <command commandId="io.github.niwantha33.zew.editor" label="Refresh C/C++ Editor Settings" style="push"/>
        <command commandId="io.github.niwantha33.zew.build" label="Build Application" style="push"/>
        <command commandId="io.github.niwantha33.zew.rebuild" label="Pristine Rebuild" style="push"/>
        <command commandId="io.github.niwantha33.zew.artifacts" label="Build and Show Firmware..." style="push"/>
        <command commandId="io.github.niwantha33.zew.cancel" label="Cancel Operation" style="push"/>
        <command commandId="io.github.niwantha33.zew.run" label="Run in Emulator..." style="push"/>
        <command commandId="io.github.niwantha33.zew.flash" label="Flash Application..." style="push"/>
        <command commandId="io.github.niwantha33.zew.debug" label="Debug Application..." style="push"/>
        <command commandId="io.github.niwantha33.zew.debugserver" label="Start Debug Server..." style="push"/>
        <command commandId="io.github.niwantha33.zew.socRegisters" label="Show Debug Data / SoC Peripherals" style="push"/>
        <command commandId="io.github.niwantha33.zew.faultAnalysis" label="Investigate Fatal Log…" style="push"/>
        <command commandId="io.github.niwantha33.zew.trace" label="Capture RTOS Trace (Preview)..." style="push"/>
        <separator name="updates" visible="true"/>
        <command commandId="io.github.niwantha33.zew.checkUpdates" label="Check for Workbench Updates..." style="push"/>
        <command commandId="io.github.niwantha33.zew.updateConnection" label="Configure Workbench Updates..." style="push"/>
