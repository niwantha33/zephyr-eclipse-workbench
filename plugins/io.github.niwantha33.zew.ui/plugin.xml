    <command id="io.github.niwantha33.zew.setup" name="Set Up Zephyr" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.debugTools" name="Manage Shared OpenOCD Debug Tools" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.tools" name="Install / Manage Zephyr Tools" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.about" name="About Zephyr Workbench" categoryId="io.github.niwantha33.zew.commands"/>
    <category id="io.github.niwantha33.zew.commands" name="Zephyr Workbench"/>
    <command id="io.github.niwantha33.zew.checkUpdates" name="Check for Workbench Updates" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.updateConnection" name="Configure Workbench Updates" categoryId="io.github.niwantha33.zew.commands"/>
