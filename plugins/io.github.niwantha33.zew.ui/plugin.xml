    <command id="io.github.niwantha33.zew.artifacts" name="Build and Show Firmware" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.build" name="Build Application" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.rebuild" name="Pristine Rebuild" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.cancel" name="Cancel Operation" categoryId="io.github.niwantha33.zew.commands"/>
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler commandId="io.github.niwantha33.zew.socRegisters" class="io.github.niwantha33.zew.ui.SocRegistersHandler"/>
    <handler commandId="io.github.niwantha33.zew.faultAnalysis" class="io.github.niwantha33.zew.ui.FaultAnalysisHandler"/>
    <handler commandId="io.github.niwantha33.zew.configurationStudio" class="io.github.niwantha33.zew.ui.ConfigurationStudioHandler"/>
    <handler commandId="org.eclipse.ui.project.buildProject" class="io.github.niwantha33.zew.ui.ZephyrBuildHandler">
      <activeWhen>
        <with variable="selection">
          <count value="1"/>
          <iterate ifEmpty="false">
            <test property="io.github.niwantha33.zew.ui.isZephyrProject" value="true" forcePluginActivation="true"/>
          </iterate>
        </with>
      </activeWhen>
    </handler>
    <handler commandId="io.github.niwantha33.zew.trace" class="io.github.niwantha33.zew.ui.ZephyrTraceHandler"/>
    <handler commandId="io.github.niwantha33.zew.debugserver" class="io.github.niwantha33.zew.ui.ProjectActionHandler"/>
    <handler commandId="io.github.niwantha33.zew.debug" class="io.github.niwantha33.zew.ui.ZephyrDebugHandler"/>
    <handler commandId="io.github.niwantha33.zew.flash" class="io.github.niwantha33.zew.ui.ProjectActionHandler"/>
    <handler commandId="io.github.niwantha33.zew.run" class="io.github.niwantha33.zew.ui.ProjectActionHandler"/>
    <handler commandId="io.github.niwantha33.zew.editor" class="io.github.niwantha33.zew.ui.EditorHandler"/>
    <handler commandId="io.github.niwantha33.zew.quickStart" class="io.github.niwantha33.zew.ui.ZephyrQuickStartHandler"/>
    <handler commandId="io.github.niwantha33.zew.setup" class="io.github.niwantha33.zew.ui.SetupHandler"/>
    <handler commandId="io.github.niwantha33.zew.debugTools" class="io.github.niwantha33.zew.ui.DebugToolsHandler"/>
    <handler commandId="io.github.niwantha33.zew.tools" class="io.github.niwantha33.zew.ui.ToolsHandler"/>
    <handler commandId="io.github.niwantha33.zew.about" class="io.github.niwantha33.zew.ui.VersionHandler"/>
    <handler commandId="io.github.niwantha33.zew.checkUpdates" class="io.github.niwantha33.zew.ui.UpdateHandler"/>
    <handler commandId="io.github.niwantha33.zew.updateConnection" class="io.github.niwantha33.zew.ui.UpdateHandler"/>
    <handler commandId="io.github.niwantha33.zew.diagnostics" class="io.github.niwantha33.zew.ui.WorkbenchHandler"/>
    <handler commandId="io.github.niwantha33.zew.artifacts" class="io.github.niwantha33.zew.ui.ZephyrArtifactsHandler"/>
    <handler commandId="io.github.niwantha33.zew.build" class="io.github.niwantha33.zew.ui.ZephyrBuildHandler"/>
    <handler commandId="io.github.niwantha33.zew.rebuild" class="io.github.niwantha33.zew.ui.ZephyrBuildHandler"/>
    <handler commandId="io.github.niwantha33.zew.cancel" class="io.github.niwantha33.zew.ui.WorkbenchHandler"/>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
      <menu id="io.github.niwantha33.zew.menu" label="Zephyr">
        <command commandId="io.github.niwantha33.zew.quickStart" label="Start Here — Create Zephyr Project..." style="push"/>
        <command commandId="io.github.niwantha33.zew.setup" label="Set Up Zephyr..." style="push"/>
        <command commandId="io.github.niwantha33.zew.tools" label="Install / Manage Zephyr Tools..." style="push"/>
        <command commandId="io.github.niwantha33.zew.debugTools" label="Manage Shared OpenOCD Debug Tools..." style="push"/>
        <separator name="tools" visible="true"/>
