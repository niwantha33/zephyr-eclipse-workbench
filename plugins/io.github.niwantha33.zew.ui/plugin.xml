        sourcePathComputerId="org.eclipse.cdt.debug.core.sourcePathComputer"/>
  </extension>
  <extension point="org.eclipse.core.expressions.propertyTesters">
    <propertyTester id="io.github.niwantha33.zew.ui.projectTester"
        type="java.lang.Object" namespace="io.github.niwantha33.zew.ui"
        properties="isImportedProject,isZephyrProject,isConfigurationStudioTarget" class="io.github.niwantha33.zew.ui.ZephyrProjectTester"/>
  </extension>
  <extension point="org.eclipse.core.runtime.adapters">
    <factory adaptableType="org.eclipse.core.resources.IResource" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
    <factory adaptableType="org.eclipse.debug.core.model.IDebugElement" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
    <factory adaptableType="org.eclipse.debug.core.ILaunch" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
    <factory adaptableType="org.eclipse.debug.core.model.IProcess" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
  </extension>
  <extension point="org.eclipse.debug.ui.launchShortcuts">
    <shortcut id="io.github.niwantha33.zew.ui.debugShortcut" label="Zephyr Application"
        modes="debug" class="io.github.niwantha33.zew.ui.ZephyrDebugShortcut">
      <contextualLaunch>
        <enablement>
          <with variable="selection">
            <count value="1"/>
            <iterate ifEmpty="false">
              <test property="io.github.niwantha33.zew.ui.isImportedProject"
                  value="true" forcePluginActivation="true"/>
            </iterate>
          </with>
        </enablement>
      </contextualLaunch>
      <configurationType id="io.github.niwantha33.zew.ui.launchType"/>
    </shortcut>
    <shortcut id="io.github.niwantha33.zew.ui.flashShortcut" label="Zephyr Flash"
        modes="run" class="io.github.niwantha33.zew.ui.ZephyrFlashShortcut">
      <contextualLaunch>
        <enablement>
          <with variable="selection">
            <count value="1"/>
            <iterate ifEmpty="false">
              <test property="io.github.niwantha33.zew.ui.isImportedProject"
                  value="true" forcePluginActivation="true"/>
            </iterate>
          </with>
        </enablement>
      </contextualLaunch>
      <configurationType id="io.github.niwantha33.zew.ui.launchType"/>
    </shortcut>
  </extension>
