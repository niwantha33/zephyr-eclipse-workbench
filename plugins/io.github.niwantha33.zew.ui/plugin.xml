      </menu>
    </menuContribution>
  </extension>
  <!-- Project Explorer / Package Explorer: a focused right-click entry for
       Zephyr projects and project configuration descriptors only. -->
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions" allPopups="false">
      <command commandId="io.github.niwantha33.zew.configurationStudio"
               label="Open Zephyr Configuration Studio..."
               tooltip="Edit prj.conf in a friendly GUI or inspect compiled Devicetree"
               style="push">
        <visibleWhen checkEnabled="false">
          <with variable="activeMenuSelection">
            <count value="1"/>
            <iterate ifEmpty="false">
              <test property="io.github.niwantha33.zew.ui.isConfigurationStudioTarget"
                    value="true" forcePluginActivation="true"/>
            </iterate>
          </with>
        </visibleWhen>
      </command>
    </menuContribution>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
      <toolbar id="io.github.niwantha33.zew.ui.buildAndFlash">
        <command commandId="org.eclipse.ui.project.buildProject"
            icon="platform:/plugin/org.eclipse.cdt.ui/icons/elcl16/build_exec.png"
            label="Build Project" tooltip="Build selected project using its Eclipse builder" style="push"/>
        <command commandId="io.github.niwantha33.zew.flash" icon="icons/flash.png"
            label="Flash Zephyr firmware" tooltip="Build and flash the selected Zephyr project" style="push"/>
      </toolbar>
    </menuContribution>
  </extension>
</plugin>

