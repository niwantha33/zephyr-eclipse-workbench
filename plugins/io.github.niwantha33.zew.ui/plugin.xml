        type="io.github.niwantha33.zew.ui.launchType" modes="run"
        delegate="io.github.niwantha33.zew.ui.ZephyrLaunchDelegate"
        name="Zephyr Runner"/>
  </extension>
  <extension point="org.eclipse.debug.core.launchDelegates">
    <launchDelegate id="io.github.niwantha33.zew.ui.nativeDsfDebug"
        type="io.github.niwantha33.zew.ui.launchType" modes="debug"
        delegate="io.github.niwantha33.zew.ui.ZephyrNativeDebugDelegate"
        name="Zephyr (CDT DSF-GDB)"
