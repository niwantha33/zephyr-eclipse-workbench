<plugin>
  <extension point="org.eclipse.core.resources.natures" id="zephyrNature" name="Zephyr Project">
    <runtime><run class="io.github.niwantha33.zew.ui.ZephyrProjectNature"/></runtime>
  </extension>
  <extension point="org.eclipse.cdt.core.buildConfigProvider">
    <provider id="io.github.niwantha33.zew.ui.westProvider" natureId="io.github.niwantha33.zew.ui.zephyrNature"
        class="io.github.niwantha33.zew.ui.ZephyrCoreBuildProvider"/>
  </extension>
  <extension point="org.eclipse.ui.ide.projectConfigurators">
    <projectConfigurator class="io.github.niwantha33.zew.ui.ZephyrProjectConfigurator" label="Zephyr Application"/>
  </extension>
  <extension point="org.eclipse.core.resources.markers" id="configurationProblem" name="Zephyr project configuration">
    <super type="org.eclipse.core.resources.problemmarker"/><persistent value="true"/>
  </extension>
  <extension point="org.eclipse.core.resources.markers" id="buildProblem" name="Zephyr build diagnostic">
    <super type="org.eclipse.core.resources.problemmarker"/><persistent value="true"/>
  </extension>
  <extension point="org.eclipse.ui.newWizards">
    <category id="io.github.niwantha33.zew.category" name="Zephyr"/>
    <wizard id="io.github.niwantha33.zew.newProject" name="Zephyr Project" category="io.github.niwantha33.zew.category" project="true" class="io.github.niwantha33.zew.ui.ZephyrProjectWizard"/>
  </extension>
  <extension point="org.eclipse.ui.importWizards">
    <category id="io.github.niwantha33.zew.importCategory" name="Zephyr"/>
    <wizard id="io.github.niwantha33.zew.importProject" name="Existing Zephyr Application" category="io.github.niwantha33.zew.importCategory" class="io.github.niwantha33.zew.ui.ZephyrImportWizard"/>
  </extension>
  <extension point="org.eclipse.cdt.core.LanguageSettingsProvider">
    <provider id="io.github.niwantha33.zew.ui.editor.compiler" name="Zephyr compiler settings" class="io.github.niwantha33.zew.ui.ZephyrLanguageSettingsProvider"/>
  </extension>
  <extension point="org.eclipse.cdt.core.CConfigurationDataProvider" id="editorData">
    <provider class="io.github.niwantha33.zew.ui.ZephyrEditorDataProvider"/>
  </extension>
  <extension point="org.eclipse.ui.propertyPages">
    <page id="io.github.niwantha33.zew.projectProperties" name="Zephyr"
          objectClass="org.eclipse.core.resources.IProject"
          class="io.github.niwantha33.zew.ui.ZephyrProjectPropertyPage"/>
  </extension>
  <extension point="org.eclipse.debug.core.launchConfigurationTypes">
    <launchConfigurationType id="io.github.niwantha33.zew.ui.launchType"
        name="Zephyr Application" modes="run,debug"
        public="true"/>
  </extension>
  <extension point="org.eclipse.debug.core.launchDelegates">
    <launchDelegate id="io.github.niwantha33.zew.ui.runRunner"
        type="io.github.niwantha33.zew.ui.launchType" modes="run"
        delegate="io.github.niwantha33.zew.ui.ZephyrLaunchDelegate"
        name="Zephyr Runner"/>
  </extension>
  <extension point="org.eclipse.debug.core.launchDelegates">
    <launchDelegate id="io.github.niwantha33.zew.ui.nativeDsfDebug"
        type="io.github.niwantha33.zew.ui.launchType" modes="debug"
        delegate="io.github.niwantha33.zew.ui.ZephyrNativeDebugDelegate"
        name="Zephyr (CDT DSF-GDB)"
        sourceLocatorId="org.eclipse.cdt.debug.core.sourceLocator"
        sourcePathComputerId="org.eclipse.cdt.debug.core.sourcePathComputer"/>
  </extension>
  <extension point="org.eclipse.core.expressions.propertyTesters">
    <propertyTester id="io.github.niwantha33.zew.ui.projectTester"
        type="java.lang.Object" namespace="io.github.niwantha33.zew.ui"
        properties="isImportedProject,isZephyrProject,isConfigurationStudioTarget" class="io.github.niwantha33.zew.ui.ZephyrProjectTester"/>
  </extension>
  <extension point="org.eclipse.core.runtime.adapters">
    <factory adaptableType="org.eclipse.core.resources.IResource" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
    <factory adaptableType="org.eclipse.debug.core.model.IDebugElement" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
    <factory adaptableType="org.eclipse.debug.core.ILaunch" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
    <factory adaptableType="org.eclipse.debug.core.model.IProcess" class="">
      <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
    </factory>
  </extension>
  <extension point="org.eclipse.debug.ui.launchShortcuts">
    <shortcut id="io.github.niwantha33.zew.ui.debugShortcut" label="Zephyr Application"
        modes="debug" class="io.github.niwantha33.zew.ui.ZephyrDebugShortcut">
      <contextualLaunch>
        <enablement>
          <with variable="selection">
            <count value="1"/>
            <iterate ifEmpty="false">
              <test property="io.github.niwantha33.zew.ui.isImportedProject"
                  value="true" forcePluginActivation="true"/>
            </iterate>
          </with>
        </enablement>
      </contextualLaunch>
      <configurationType id="io.github.niwantha33.zew.ui.launchType"/>
    </shortcut>
    <shortcut id="io.github.niwantha33.zew.ui.flashShortcut" label="Zephyr Flash"
        modes="run" class="io.github.niwantha33.zew.ui.ZephyrFlashShortcut">
      <contextualLaunch>
        <enablement>
          <with variable="selection">
            <count value="1"/>
            <iterate ifEmpty="false">
              <test property="io.github.niwantha33.zew.ui.isImportedProject"
                  value="true" forcePluginActivation="true"/>
            </iterate>
          </with>
        </enablement>
      </contextualLaunch>
      <configurationType id="io.github.niwantha33.zew.ui.launchType"/>
    </shortcut>
  </extension>
  <extension point="org.eclipse.debug.ui.launchConfigurationTabGroups">
    <launchConfigurationTabGroup id="io.github.niwantha33.zew.ui.launchTabs"
        type="io.github.niwantha33.zew.ui.launchType"
        class="io.github.niwantha33.zew.ui.ZephyrLaunchTabs"/>
  </extension>
  <extension point="org.eclipse.ui.startup"><startup class="io.github.niwantha33.zew.ui.SetupStartup"/></extension>
  <extension point="org.eclipse.core.resources.builders" id="zephyrBuilder" name="Zephyr Project Builder">
    <builder hasNature="false"><run class="io.github.niwantha33.zew.ui.ZephyrProjectBuilder"/></builder>
  </extension>
  <extension point="org.eclipse.ui.startup"><startup class="io.github.niwantha33.zew.ui.UpdateStartup"/></extension>
  <extension point="org.eclipse.ui.views">
    <view id="io.github.niwantha33.zew.ui.faultAnalysis" name="Zephyr Fault Investigation"
          category="org.eclipse.debug.ui" class="io.github.niwantha33.zew.ui.FaultAnalysisView" restorable="true"/>
    <view id="io.github.niwantha33.zew.ui.socRegisters" name="SoC Peripherals / Registers"
          category="org.eclipse.debug.ui"
          class="io.github.niwantha33.zew.ui.SocRegistersView" restorable="true"/>
    <view id="io.github.niwantha33.zew.ui.configurationStudio"
          name="Zephyr Configuration Studio"
          class="io.github.niwantha33.zew.ui.ConfigurationStudioView"
          restorable="true"/>
  </extension>
  <extension point="org.eclipse.ui.perspectiveExtensions">
    <perspectiveExtension targetID="org.eclipse.debug.ui.DebugPerspective">
      <view id="io.github.niwantha33.zew.ui.socRegisters" relative="org.eclipse.debug.ui.VariableView"
            relationship="stack" visible="true"/>
    </perspectiveExtension>
  </extension>
  <extension point="org.eclipse.ui.preferencePages">
    <page id="io.github.niwantha33.zew.preferences" name="Zephyr Workbench" class="io.github.niwantha33.zew.ui.WorkbenchPreferences"/>
  </extension>
  <extension point="org.eclipse.ui.commands">
    <command id="io.github.niwantha33.zew.socRegisters" name="Show Debug Data and SoC Peripherals" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.faultAnalysis" name="Investigate Fatal Log" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.configurationStudio" name="Open Configuration Studio" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.trace" name="Capture RTOS Trace" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.debugserver" name="Start Debug Server" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.debug" name="Debug Application" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.flash" name="Flash Application" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.run" name="Run in Emulator" categoryId="io.github.niwantha33.zew.commands"/>
    <command id="io.github.niwantha33.zew.editor" name="Refresh C/C++ Editor Settings" categoryId="io.github.niwantha33.zew.commands"/>
